# CandleCore Environment Variables

# Database
DATABASE_URL=postgresql+asyncpg://candlecore:candlecore@localhost:5432/candlecore

# Delta Exchange (India) - Public endpoints only, no credentials needed for CC-M1
DELTA_REST_BASE_URL=https://api.india.delta.exchange
DELTA_WS_URL=wss://public-socket.india.delta.exchange

# CC-M1 collection scope (3m is the CC-M1 collection interval only,
# NOT a platform-wide primary timeframe)
CC_M1_SYMBOLS=BTCUSD,ETHUSD,SOLUSD
CC_M1_TIMEFRAMES=3m

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# API
API_HOST=0.0.0.0
API_PORT=8000

# HTTP retry settings (safe, idempotent GET requests only)
HTTP_MAX_RETRIES=5
HTTP_BASE_DELAY=1.0
HTTP_MAX_DELAY=60.0

# HTTP timeout (seconds)
HTTP_TIMEOUT=30.0

# WebSocket reconnect max delay (seconds)
WS_MAX_RECONNECT_DELAY=60.0
